# ---------------------------------------------------------------------------
# AI Services environment variables
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# Groq API key for chat/LLM functionality
# Get this from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Supabase configuration
# Get these from your Supabase dashboard: Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key-here

# Shared secret required in the X-Internal-Token header on every request to
# this service (except /health). Must match AI_SERVICE_TOKEN in
# backend/.env. If left empty, this check is skipped — fine for local
# development, but set it wherever this service's network could be reached
# by anything other than the Node backend.
AI_SERVICE_TOKEN=
