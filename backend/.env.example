# ---------------------------------------------------------------------------
# Backend environment variables
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# Runtime environment: development | production | test
NODE_ENV=development

# Port the Express server listens on
PORT=4000

# Comma-separated list of origins allowed by CORS (e.g. the React dev server)
CORS_ORIGIN=http://localhost:5173

# --- Rate limiting -----------------------------------------------------------
# Time window in milliseconds and the max requests allowed per IP in that window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Supabase --------------------------------------------------------------
# Project URL and keys from the Supabase dashboard (Project Settings → API).
# SUPABASE_URL + SUPABASE_ANON_KEY are used to verify user access tokens.
# SUPABASE_SERVICE_ROLE_KEY is a server-only admin secret — NEVER expose it to
# the frontend and never commit a real value.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- FastAPI AI service ----------------------------------------------------
# Base URL of the existing FastAPI risk/prediction service.
FASTAPI_URL=http://localhost:8000
# How long (ms) to wait for the AI service before giving up.
FASTAPI_TIMEOUT_MS=15000
